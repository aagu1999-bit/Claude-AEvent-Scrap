modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Event Pipeline"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "History Migration"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Reprocess Weekends"

[[workflows.workflow]]
name = "Event Pipeline"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "History Migration"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python migrate_history.py"

[[workflows.workflow]]
name = "Reprocess Weekends"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python reprocess_weekends.py --confirm"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run dashboard.py --server.port 5000 --server.address 0.0.0.0 --server.headless true"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
